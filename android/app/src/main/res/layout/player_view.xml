<?xml version="1.0" encoding="utf-8"?>
<!--
  Video yüzeyi Flutter'ın PlatformView katmanı içinde çizildiği için
  surface_type=texture_view ZORUNLU: PlayerView'ın varsayılanı SurfaceView'dır
  ve Flutter'ın sanal ekran (virtual display) tabanlı gömme yönteminde
  SurfaceView siyah kare olarak görünür.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:show_buffering="always" />
