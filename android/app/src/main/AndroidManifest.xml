<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Uygulama içi güncelleme: indirilen APK'nın kurulumunu başlatmak için.
         Kurulumu sistem yapar, kullanıcı onaylar. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Telefondan televizyona video gönderme (cast): televizyon, telefonun
         ağa saldığı keşif paketini alabilmek için Wi-Fi çoklu yayın kilidini
         alıyor. Android, bu kilit olmadan gelen yayın (broadcast) paketlerini
         uygulamalara HİÇ vermiyor — izin olmasa keşif sessizce çalışmazdı.
         Komut trafiği için ek izin gerekmiyor; INTERNET yeterli.
         Not: Android 17 (targetSdk 37) yerel ağ erişimini ayrı bir çalışma
         anı iznine bağlıyor; targetSdk yükseltilirken bu özellik yeniden
         gözden geçirilmeli. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Televizyonda yayın alıcısı, uygulama kapalıyken de ağı dinliyor.
         Ön plan servisi olmadan Android 8+ servisi birkaç dakikada öldürüyor;
         "specialUse" türü, hazır türlerin hiçbirine (medya, konum, veri
         eşitleme) uymayan bu yerel ağ dinleyicisi için doğru olan. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Televizyon açılır açılmaz alıcı hazır olsun: yoksa kullanıcının
         telefondan gönderebilmek için önce televizyona gidip uygulamayı
         kumandayla açması gerekiyordu. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Televizyonda uygulama KAPALIYKEN gelen yayın isteğinin uygulamayı
         açabilmesi için. Android 10+ arka plandaki uygulamaların ekran
         açmasını yasaklıyor; "diğer uygulamaların üzerinde göster" izni bu
         yasağın belgelenmiş tek pratik istisnası (pil optimizasyonu muafiyeti
         YETMİYOR — ölçüldü, BAL_BLOCK dönüyor).
         İzin KENDİLİĞİNDEN verilmiyor: kullanıcı ayarlardan bir kez açıyor,
         açmazsa televizyonda uygulamayı elle açması gerektiği söyleniyor. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- İndirilen MP3'ler herkesin eriştiği Music/oLusTifF klasörüne kaydediliyor.
         Android 10+ bunu MediaStore üzerinden izinsiz yapar; yalnızca Android 9
         ve öncesinde ortak depolamaya yazmak/okumak için izin gerekiyor. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <!-- Bluetooth ses aygıtı bağlanınca çalmaya devam etmek için.
         BLUETOOTH_CONNECT Android 12+ karşılığıdır. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Bluetooth bağlanınca arka planda müzik başlatabilmek için.
         Android 12+ arka plandan servis başlatmayı yasaklar; pil
         optimizasyonundan muaf olmak bunun tek geçerli istisnasıdır. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- Telefon + Android TV her ikisinde de kurulabilsin diye dokunmatik ekran ZORUNLU değil -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>

    <!-- tools:replace: LAME kütüphanesi kendi uygulama etiketini bildiriyor,
         bizimki geçerli olmalı. -->
    <application
        android:label="oLusTifF"
        tools:replace="android:label"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Android TV / Google TV launcher'ında görünmesi için -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Video, Flutter'ın Texture widget'ıyla (harici doku) çiziliyor.
             Impeller'ın Vulkan yolu bazı Mali sürücülerinde bu dokuyu yanlış
             satır adımıyla okuyor ve görüntü mozaik gibi bozuluyor; Android TV
             kutusunda (Mali-G52) A/B testiyle doğrulandı. Impeller kapalıyken
             aynı video kusursuz çiziliyor.
             Tek yapılandırma, tüm cihazlarda geçerli. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- Uygulama tamamen kapalıyken de tetiklenir: sistem uygulamayı
             yalnızca bu alıcı için ayağa kaldırır, ekran açılmaz. -->
        <receiver
            android:name=".player.BluetoothAutoPlayReceiver"
            android:exported="true">
            <intent-filter>
                <!-- Ses profili (A2DP) kurulduğunda tetiklenir. Cihazın
                     "bağlandığı" an (ACL_CONNECTED) müzik kanalı henüz
                     hazır olmuyor. -->
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Televizyonda telefondan gelen yayını karşılayan alıcı.
             Aktiviteden BAĞIMSIZ yaşar: uygulama televizyonda hiç açık
             olmasa bile keşifte görünür ve gelen istek uygulamayı açar.
             Yalnızca televizyonda başlatılıyor (bkz. CastReceiverService). -->
        <service
            android:name=".cast.CastReceiverService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Yerel agdan gelen yayin (cast) isteklerini dinler"/>
        </service>

        <!-- Televizyon açılışında alıcıyı ayağa kaldırır. -->
        <receiver
            android:name=".cast.CastBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Arka planda müzik/video oynatma: aktivite kapansa/uygulama minimize
             olsa bile çalmaya devam eden, bildirimden kontrol edilebilen medya oturumu. -->
        <service
            android:name=".player.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService"/>
            </intent-filter>
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Sesli arama: mikrofon düğmesini yalnızca cihazda ses tanıma
             VARSA göstermek istiyoruz. Android 11+ paket görünürlüğü
             kısıtladığı için queryIntentActivities bu kayıt olmadan boş
             döner ve düğme hiçbir cihazda görünmezdi.
             Aramayı sistemin ses tanıma ekranı yapıyor; bu yüzden
             RECORD_AUDIO iznine gerek yok. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
        </intent>
    </queries>
</manifest>
